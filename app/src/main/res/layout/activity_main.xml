<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="@string/status_idle" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:alpha="0.75"
                android:text="@string/hint_modifier_lock" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                style="@style/KeyButton"
                android:text="@string/action_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/KeyButton"
                android:text="@string/action_connect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                style="@style/KeyButton"
                android:text="@string/action_disconnect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discoverableButton"
                style="@style/KeyButton"
                android:text="@string/action_discoverable" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendTextButton"
                style="@style/KeyButton"
                android:text="@string/action_send_text" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:minHeight="96dp"
        app:cardCornerRadius="14dp"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.slick.btkeyboard.KeyCaptureView
                android:id="@+id/captureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/echoText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:gravity="bottom"
                android:clickable="false"
                android:focusable="false"
                android:textIsSelectable="false"
                android:maxLines="6"
                android:ellipsize="start"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:text="@string/capture_hint" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modifierGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="false"
        app:singleSelection="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modCtrl"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:textAllCaps="false"
            android:text="@string/mod_ctrl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modShift"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:textAllCaps="false"
            android:text="@string/mod_shift" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modAlt"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:textAllCaps="false"
            android:text="@string/mod_alt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modGui"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:textAllCaps="false"
            android:text="@string/mod_gui" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navKeyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/functionKeyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
